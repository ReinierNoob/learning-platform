# Shared EAW Supabase (catalog, Auth, entitlements, learning progress)
EAW_SUPABASE_URL=https://<eaw-supabase-ref>.supabase.co
EAW_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Existing media-only Supabase project used by cursus-videos
VIDEO_SUPABASE_URL=https://<video-supabase-ref>.supabase.co
VIDEO_SUPABASE_SERVICE_ROLE_KEY=<server-only>
# Legacy deployment may use SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY for this media project.

# AI instructor
OPENAI_API_KEY=<server-only>
OPENAI_MODEL=gpt-5-mini

# Return link to the commercial EAW account area
EAW_ACCOUNT_URL=https://enterprisearchitectureworks.nl/account
